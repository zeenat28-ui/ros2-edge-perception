# ==============================================================================
# AURA-Drive™ Enterprise Environment Variables Template
# Standard: ISO 21434 Cybersecurity & Zero-Trust Secret Management
# Note: Never commit real production secrets (.env) to version control.
# ==============================================================================

# Core System
AURA_ROBOT_ID="AURA-AMR-001"
AURA_FLEET_ID="ZONE_A_WAREHOUSE_CENTRAL"
AURA_ENVIRONMENT="production"
AURA_LOG_LEVEL="INFO"

# DevSecOps Cryptographic Secret Key (HS256 256-bit minimum key)
# Generate with: openssl rand -hex 32
AURA_AUTH_SECRET_KEY="generate_a_secure_256_bit_random_hex_key_here"

# VDA 5050 MQTT Broker Credentials
AURA_MQTT_BROKER_HOST="127.0.0.1"
AURA_MQTT_BROKER_PORT="8883"
AURA_MQTT_USE_TLS="true"
AURA_MQTT_TLS_CA_CERT="/etc/aura/certs/ca.crt"
AURA_MQTT_TLS_CLIENT_CERT="/etc/aura/certs/client.crt"
AURA_MQTT_TLS_CLIENT_KEY="/etc/aura/certs/client.key"
AURA_MQTT_USERNAME="aura_amr_client"
AURA_MQTT_PASSWORD="change_to_secure_mqtt_password"

# Hardware Acceleration & Compute
AURA_CUDA_VISIBLE_DEVICES="0"
AURA_ONNX_PROVIDER="CUDAExecutionProvider"
AURA_INFERENCE_PRECISION="FP16"

# MLOps Model Gate & Telemetry
AURA_MLOPS_TELEMETRY_ENDPOINT="https://mlops-telemetry.aura-fleet.internal/v1/metrics"
AURA_MLOPS_DRIFT_ALERT_WEBHOOK="https://alerts.aura-fleet.internal/webhook/drift"

{
  "defaultAction": "SCMP_ACT_ERRNO",
  "architectures": [
    "SCMP_ARCH_X86_64",
    "SCMP_ARCH_AARCH64"
  ],
  "syscalls": [
    {
      "names": [
        "accept", "accept4", "access", "bind", "brk", "clock_gettime", "clone", "clone3", "close",
        "connect", "epoll_create1", "epoll_ctl", "epoll_pwait", "epoll_wait", "exit",
        "exit_group", "faccessat2", "fcntl", "fstat", "futex", "getcwd", "getdents", "getdents64", "getpid",
        "getrandom", "getsockname", "getsockopt", "gettid", "gettimeofday", "ioctl",
        "listen", "lseek", "madvise", "mmap", "mprotect", "munmap", "nanosleep", "newfstatat",
        "openat", "pipe2", "poll", "prctl", "pread64", "pwrite64", "read", "readlink",
        "readlinkat", "recvfrom", "recvmsg", "rseq", "rt_sigaction", "rt_sigprocmask",
        "rt_sigreturn", "sched_getaffinity", "sched_setaffinity", "sched_yield", "select",
        "sendmsg", "sendto", "set_robust_list", "setsockopt",
        "shutdown", "sigaltstack", "socket", "stat", "sysinfo", "write", "writev"
      ],
      "action": "SCMP_ACT_ALLOW"
    },
    {
      "names": [
        "ptrace", "reboot", "sys_chroot", "kexec_load", "kexec_file_load",
        "init_module", "finit_module", "delete_module", "bpf", "userfaultfd"
      ],
      "action": "SCMP_ACT_KILL"
    }
  ]
}

